---
import AppLayout from './AppLayout.astro';
interface Props { title: string }
const { title } = Astro.props;
const links = [
  ['/admin/', '總覽'], ['/admin/enrollments/', '報名與核款'], ['/admin/members/', '會員'], ['/admin/courses/', '課程講師'],
  ['/admin/instructors/', '講師申請'], ['/admin/moderation/', '隱藏與申訴'], ['/admin/audit/', '操作紀錄'],
];
---
<AppLayout title={`管理區：${title}`}>
  <nav class="admin-nav" aria-label="管理區">
    {links.map(([href, label]) => <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{label}</a>)}
  </nav>
  <h1>{title}</h1>
  <slot />
</AppLayout>
<style>
  .admin-nav { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); padding-bottom: var(--space-4); border-bottom: 1px solid var(--color-line); margin-bottom: var(--space-6); font-size: var(--text-sm); }
  .admin-nav a[aria-current='page'] { font-weight: 700; }
  :global(.admin-table) { border-collapse: collapse; width: 100%; font-size: var(--text-xs); display: block; overflow-x: auto; }
  :global(.admin-table th), :global(.admin-table td) { border: 1px solid var(--color-line); padding: var(--space-2); text-align: left; vertical-align: top; }
  :global(.admin-table form) { margin: 0 0 var(--space-2); }
</style>
