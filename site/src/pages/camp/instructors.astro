---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publicCourses } from '../../lib/courses';
const names = [...new Set((await publicCourses()).flatMap((c) => c.data.instructors))];
---
<BaseLayout title="AI 共學營講師" description="AI 共學營的講師介紹，以及成為講師的條件：至少上過一門 6,000 元標準課程，並經協會管理員審核。" breadcrumbs={[{ name: 'AI 共學營', href: '/camp/' }, { name: '講師', href: '/camp/instructors/' }]}>
  <div class="prose">
    <h1>講師</h1>
    <img class="page-hero" src="/media/illustrations/camp-instructors.webp" alt="狸貓吉祥物站在白板前準備教材，狐狸吉祥物在旁整理講義" width="1600" height="900" loading="lazy" />
    {names.length === 0
      ? <p>第一位講師的資料會在第一門課公布時一併刊出。</p>
      : <ul>{names.map((n) => <li>{n}</li>)}</ul>}
    <h2>想成為講師</h2>
    <div class="key-answer" data-question="怎麼成為 AI 共學營講師？">
      <p>先上過至少一門 6,000 元的標準課程，再提出講師申請。申請要附上專業資料、相關經驗與課程構想，由協會管理員審核；核准後才能建立正式課程。</p>
    </div>
    <p><a href="/camp/instructor-application/">看講師申請方式</a></p>
  </div>
</BaseLayout>
<style>
  .page-hero { width: 100%; height: auto; border-radius: var(--radius); margin-bottom: var(--space-6); }
</style>
