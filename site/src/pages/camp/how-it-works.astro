---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { campRules } from '../../data/site.js';
const fee = campRules.minFee.toLocaleString('zh-TW');
const steps = [
  { name: '看講師成果，先自己試', text: '每項成果都公開講師的做法、全部技能單張和 GitHub 上的程式。照著做，或把好棋寶寶裝進你的 AI、讓 AI 陪你做；做得出來就不用報名。' },
  { name: '卡住了，到討論區問', text: '每項成果有自己的公開討論區，登入就能發問。講師有空會回，其他人也能回。' },
  { name: '做不來，登記想學', text: '登入後在成果頁按「登記想學」。不用付費、不必入會，隨時可以取消。講師填了每週時段的話，選你方便的時段。' },
  { name: '滿人數，自動開團', text: '登記滿講師訂的人數就開團。主題教學的日期依講師的設定排定：直接排進你選的時段、由講師提出候選日期讓大家投票參考，或照講師預訂的日期。' },
  { name: '報名並匯款', text: `開團後你會收到通知。到團頁報名，匯款到協會帳戶，再填匯款日期和帳號末五碼，由協會管理員核對。團費由講師訂，最低 ${fee} 元。` },
  { name: '上主題教學', text: '線上直播或實體上課，由講師決定。上課時在上課區簽到，技能單張也在上課區。' },
  { name: '3 週實作，做出你的成果', text: '你自己找題目，每週在課程論壇交一次：第 1 週題目、第 2 週第一版、第 3 週成果。系統會在截止前提醒。' },
  { name: '結營，論壇保留', text: '主題教學後滿 1 個月結營，請填問卷。課程論壇會保留，可以繼續交流。' },
];
const howto = {
  '@context': 'https://schema.org', '@type': 'HowTo', name: '如何參加 AI 共學營', totalTime: 'P1M',
  estimatedCost: { '@type': 'MonetaryAmount', currency: 'TWD', minValue: campRules.minFee },
  step: steps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.name, text: s.text })),
};
---
<BaseLayout title="AI 共學營參加流程" description={`先看講師成果自己試，做不來就登記想學，滿人數自動開團。報名匯款、主題教學、3 週實作做出成果，1 個月，團費最低 ${fee} 元。`} breadcrumbs={[{ name: 'AI 共學營', href: '/camp/' }, { name: '參加流程', href: '/camp/how-it-works/' }]} schema={[howto]}>
  <article class="prose">
    <h1>參加流程</h1>
    <div class="key-answer" data-question="參加 AI 共學營要做哪些事？">
      <p>先看講師的成果自己試；做不來就登記想學，滿人數自動開團。開團後報名匯款，上 1 堂主題教學，再用 3 週做出你自己的成果。整團{campRules.duration}，團費由講師訂，最低 {fee} 元，不必入會。</p>
    </div>
    <ol class="actionable-steps">{steps.map((s) => <li><strong>{s.name}</strong><p>{s.text}</p></li>)}</ol>
    <h2>退款</h2>
    <ul>
      <li>主題教學開始前，可以在團頁申請全額退款；開始後不退。</li>
      <li>匯款期限內付款人數不夠、沒有成團，已匯款的人全額退款。</li>
      <li>講師取消，已匯款的人全額退款。</li>
      <li>退款由協會管理員匯回你的帳戶。</li>
    </ul>
    <h2>通知</h2>
    <p>開團、匯款期限、實作提醒等通知會顯示在帳號頁，也可以在帳號頁開啟手機或電腦的推播通知。iPhone 要先把網站加到主畫面才收得到推播。</p>
    <p><a class="btn" href="/camp/">看講師成果</a></p>
  </article>
</BaseLayout>
<style>
  .actionable-steps li { margin-bottom: var(--space-4); }
  .actionable-steps p { margin: 0; }
</style>
