---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { courseRules } from '../../data/site.js';
import { getCollection } from 'astro:content';
const open = (await getCollection('courses')).filter((c) => c.data.status === 'open');
---
<BaseLayout title="AI 共學營" description="台灣好棋寶寶協會主辦的 AI 共學營：講師先做出 AI 應用成果，學員自己做不來就登記想學，滿講師訂的人數開團。每團 1 堂主題教學、3 堂實作、一個月。" breadcrumbs={[{ name: 'AI 共學營', href: '/camp/' }]}>
  <div class="prose">
    <h1>AI 共學營</h1>
    <div class="key-answer" data-question="AI 共學營是什麼？">
      <p>AI 共學營是台灣好棋寶寶協會為會員辦的共學活動。講師先用 AI 做出成果，例如一條會自動更新的產業情報流程。你可以照著自己做；做不來，就登記想學，登記滿講師訂的人數就開團。每團 1 堂主題教學、3 堂實作，為期{courseRules.duration}，費用 {courseRules.fee.toLocaleString('zh-TW')} 元。</p>
    </div>
    <dl class="facts">
      <dt>主辦</dt><dd>台灣好棋寶寶協會</dd>
      <dt>適合誰</dt><dd>想把 AI 用在自己工作上的各行各業人士</dd>
      <dt>怎麼開團</dt><dd>講師先有成果；學員登記想學，滿講師訂的人數開團</dd>
      <dt>每團內容</dt><dd>1 堂主題教學＋3 堂實作，合計{courseRules.duration}</dd>
      <dt>費用</dt><dd>每門課 {courseRules.fee.toLocaleString('zh-TW')} 元；第一次繳的常年會費 {courseRules.fee.toLocaleString('zh-TW')} 元已含第一門課</dd>
      <dt>資格</dt><dd>協會個人會員（常年會費以年計算）</dd>
      <dt>目前開放報名</dt><dd>{open.length ? `${open.length} 團` : '還沒有成團，先看講師成果登記想學'}</dd>
    </dl>
  </div>
  <ul class="card-grid cols-3">
    <li><a class="card" href="/camp/topics/"><h2>講師成果</h2><p>講師做出來的東西；做不來就登記想學。</p></a></li>
    <li><a class="card" href="/camp/about/"><h2>共學營介紹</h2><p>誰主辦、課程裡有什麼、學員能得到什麼。</p></a></li>
    <li><a class="card" href="/camp/how-it-works/"><h2>參加流程</h2><p>從看成果、登記想學、開團報名到結營。</p></a></li>
    <li><a class="card" href="/camp/courses/"><h2>已開的團</h2><p>成團後排定日期的課程與報名。</p></a></li>
    <li><a class="card" href="/camp/instructors/"><h2>講師</h2><p>講師介紹與成為講師的方式。</p></a></li>
    <li><a class="card" href="/camp/faq/"><h2>常見問題</h2><p>費用、會員、教材、實作營與作品公開。</p></a></li>
  </ul>
</BaseLayout>
<style>
  .page-head { display: grid; gap: var(--space-4) var(--space-6); align-items: center; margin-bottom: var(--space-6); }
  @media (min-width: 640px) { .page-head { grid-template-columns: minmax(0, 1fr) 20rem; } }
  .page-head h1 { margin: 0; }
  .page-head figure { margin: 0; }
  .page-head figcaption { margin-top: var(--space-2); font-size: var(--text-xs); line-height: 1.6; color: var(--color-ink-muted); }
  .page-hero { width: 100%; max-width: 20rem; height: auto; border-radius: var(--radius); }

</style>
