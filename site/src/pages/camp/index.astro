---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Meter from '../../components/camp/Meter.astro';
import { listPublished } from '../../server/camp/showcases';
import { cohortViews, headline } from '../../server/camp/view';
import { demoLinks } from '../../server/camp/types';
import { FORMAT_LABEL } from '../../lib/labels';
import { campRules, site } from '../../data/site.js';
export const prerender = false;

const showcases = await listPublished();
const cards = await Promise.all(showcases.map(async (s) => ({ s, h: headline(s, await cohortViews(s)), demos: demoLinks(s) })));
const fee = campRules.minFee.toLocaleString('zh-TW');
const list = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'AI 共學營講師成果',
  itemListElement: showcases.map((s, i) => ({ '@type': 'ListItem', position: i + 1, url: `${site.url}/camp/r/${s.slug}/`, name: s.title })),
};
---
<BaseLayout title="AI 共學營" description={`協會會員講師用 AI 做出來的成果。照做法說明自己試；做不來就登記想學，滿人數自動開團。每團 1 堂主題教學加 3 週實作，1 個月，團費最低 ${fee} 元。`} breadcrumbs={[{ name: 'AI 共學營', href: '/camp/' }]} schema={[list]}>
  <div class="prose">
    <h1>AI 共學營</h1>
    <div class="key-answer" data-question="AI 共學營怎麼運作？">
      <p>協會的會員講師把自己用 AI 做出來的東西放在這裡。你可以照著做法說明自己試；做不來，就登記想學，登記滿講師訂的人數就自動開團。每團 1 堂主題教學加 3 週實作，為期 {campRules.duration}，團費由講師訂，最低 {fee} 元，不必入會。</p>
    </div>
  </div>
  <ol class="steps">
    <li><strong>看成果</strong>照講師的做法說明自己試</li>
    <li><strong>卡住了</strong>到成果的討論區問</li>
    <li><strong>做不來</strong>登記想學，滿人數自動開團</li>
  </ol>

  <h2>講師做出來的成果</h2>
  {cards.length === 0 && <p>第一批成果正在審核，公開後會出現在這裡。</p>}
  <ul class="card-grid cols-3">
    {cards.map(({ s, h, demos }) => (
      <li>
        <a class="card showcase" href={`/camp/r/${s.slug}/`}>
          <h3>{s.title}</h3>
          <p>{s.summary}</p>
          {demos.length > 0 && <p class="muted demos">{demos.slice(0, 3).map((d) => d.title).join('、')}{demos.length > 3 && ` 等 ${demos.length} 個`}</p>}
          <p class="muted meta">{s.instructor_name}．{FORMAT_LABEL[s.teaching_format]}．{s.price.toLocaleString('zh-TW')} 元</p>
          {'ratio' in h && h.ratio !== undefined ? <Meter ratio={h.ratio} label={h.text} /> : <p class={`status ${h.tone}`}>{h.text}</p>}
        </a>
      </li>
    ))}
  </ul>

  <section class="prose more">
    <h2>開團之後</h2>
    <dl class="facts">
      <dt>內容</dt><dd>1 堂主題教學（線上直播或實體，講師決定）＋3 週實作，為期 {campRules.duration}</dd>
      <dt>實作</dt><dd>你自己找題目，每週在課程論壇交進度：題目、第一版、成果</dd>
      <dt>團費</dt><dd>講師訂，最低 {fee} 元；開課前可全額退款</dd>
      <dt>資格</dt><dd>不必是協會會員，登入就能登記與報名</dd>
    </dl>
    <p><a href="/camp/how-it-works/">參加流程</a>．<a href="/camp/faq/">常見問題</a>．<a href="/camp/teach/">我也有成果，想當講師</a></p>
  </section>
</BaseLayout>
<style>
  .steps { display: grid; gap: var(--space-3); list-style: none; padding: 0; margin: 0 0 var(--space-8); counter-reset: s; }
  @media (min-width: 768px) { .steps { grid-template-columns: repeat(3, 1fr); } }
  .steps li { counter-increment: s; background: var(--color-bg-soft); border-radius: var(--radius); padding: var(--space-3) var(--space-4); display: grid; gap: var(--space-1); }
  .steps li::before { content: counter(s); font-weight: 800; color: var(--color-primary); }
  .showcase { display: grid; gap: var(--space-2); align-content: start; height: 100%; }
  .showcase p { margin: 0; }
  .demos, .meta { font-size: var(--text-xs); }
  .status { font-size: var(--text-xs); font-weight: 700; }
  .status.hot { color: var(--color-primary); }
  .more { margin-top: var(--space-12); }
</style>
