---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import PageHead from '../../../components/PageHead.astro';
const topics = (await getCollection('topics')).sort((a, b) => a.data.order - b.data.order);
const list = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'AI 共學營講師成果',
  itemListElement: topics.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.data.title, url: new URL(`/camp/topics/${t.data.slug}/`, Astro.site).href })),
};
---
<BaseLayout title="AI 共學營講師成果" description="講師已用 AI 做出的五項成果：情報搜集、產業供應鏈情報網、AI 應用工具、定理推導、互動研究發表。自己做不來就登記想學，滿人數開團。" breadcrumbs={[{ name: 'AI 共學營', href: '/camp/' }, { name: '講師成果', href: '/camp/topics/' }]} schema={[list]}>
  <div class="prose">
    <PageHead title="講師成果" hero="camp-topics" alt="狐狸與狸貓吉祥物站在兩旁，畫面中列出「情報搜集與 AI 輔助分析實作」、「產業供應鏈情報網與 AI 分析實作」、「從工作問題到 AI 應用工具實作」、「AI 輔助定理推導與研究驗證實作」、「AI 輔助互動研究與開源發表實作」、「正式課程」" caption="講師先做出成果，學員登記想學滿人數才開團" />
    <div class="key-answer" data-question="講師成果和開團有什麼關係？">
      <p>這裡是講師已經用 AI 做出來的東西。先照著自己做；做不來，就在成果頁登記想學。登記滿講師訂的人數才開團，開好的團會有日期與報名，列在<a href="/camp/courses/">已開的團</a>。</p>
    </div>
  </div>
  <ul class="card-grid">
    {topics.map((t) => (
      <li><a class="card" href={`/camp/topics/${t.data.slug}/`}><h2>{t.data.title}</h2><p>{t.data.summary}</p><p class="muted">適合：{t.data.audience}</p><p class="muted">滿 {t.data.groupSize} 人開團</p></a></li>
    ))}
  </ul>
</BaseLayout>
<style>
</style>
