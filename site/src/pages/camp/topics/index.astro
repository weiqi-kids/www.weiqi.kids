---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const topics = (await getCollection('topics')).sort((a, b) => a.data.order - b.data.order);
const list = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'AI 共學營課程主題',
  itemListElement: topics.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.data.title, url: new URL(`/camp/topics/${t.data.slug}/`, Astro.site).href })),
};
---
<BaseLayout title="AI 共學營課程主題" description="AI 共學營目前規劃五個課程主題：情報搜集、產業供應鏈情報網、AI 應用工具、定理推導、互動研究發表。主題不是已開課的課程。" breadcrumbs={[{ name: 'AI 共學營', href: '/camp/' }, { name: '課程主題', href: '/camp/topics/' }]} schema={[list]}>
  <div class="prose">
    <h1>課程主題</h1>
    <div class="key-answer" data-question="課程主題和正式課程有什麼不同？">
      <p>課程主題說明一種可以開課的 AI 應用能力與示範案例。講師選定主題、填寫開課表單並經協會核准後，才會成為有日期、講師與報名的<a href="/camp/courses/">正式課程</a>。</p>
    </div>
  </div>
  <ul class="card-grid">
    {topics.map((t) => (
      <li><a class="card" href={`/camp/topics/${t.data.slug}/`}><h2>{t.data.title}</h2><p>{t.data.summary}</p><p class="muted">適合：{t.data.audience}</p></a></li>
    ))}
  </ul>
</BaseLayout>
