---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ from '../../components/mdx/FAQ.astro';
import { campRules } from '../../data/site.js';
const fee = campRules.minFee.toLocaleString('zh-TW');
const items = [
  { question: 'AI 共學營什麼時候開課？', answer: '沒有固定日期。講師先把做出來的成果放上來，自己做不來的人登記想學，登記滿講師訂的人數就自動開團。' },
  { question: '登記想學要付錢或入會嗎？', answer: '都不用。登入就能登記，也可以隨時取消。開團後報名並匯款，才算參加。' },
  { question: '一團多少錢？', answer: `團費由講師訂，最低 ${fee} 元，寫在每項成果頁上。` },
  { question: '一團包含什麼？', answer: `1 堂主題教學（線上直播或實體，講師決定）、這個成果的全部技能單張，以及 3 週實作，合計${campRules.duration}。` },
  { question: '3 週實作要做什麼？', answer: '你自己找題目，每週在課程論壇交一次：第 1 週題目、第 2 週第一版、第 3 週成果。系統會在截止前提醒，沒交也沒有處罰，但我們希望每個人都做出成果。' },
  { question: '怎麼付款？', answer: '開團後在團頁報名，匯款到協會帳戶，再到網站填匯款日期和你的帳號末五碼，由協會管理員核對。網站不收匯款截圖。' },
  { question: '可以退款嗎？', answer: '主題教學開始前可以全額退款，開始後不退。沒有成團或講師取消，已匯款的人全額退款。' },
  { question: '額滿了怎麼辦？', answer: '講師訂了人數上限的話，額滿後你會留在登記名單，下一團開放時自動幫你登記。' },
  { question: '怎麼收到開團通知？', answer: '通知會顯示在帳號頁，也可以開啟手機或電腦的推播。iPhone 要先把網站加到主畫面才收得到推播；拒絕通知權限或換裝置，要重新開啟。' },
  { question: '我的作品會被公開嗎？', answer: '預設只在課程論壇給同一團的人看。講師認可、你也同意公開，作品才會出現在成果頁；你可以隨時撤回公開。' },
  { question: '結營後還能用課程論壇嗎？', answer: '可以。同一團的人仍可登入、發文與交流，講師可依意願繼續回覆。' },
  { question: '怎麼成為講師？', answer: `先成為協會會員（常年會費 ${campRules.membershipFee.toLocaleString('zh-TW')} 元），再到講師後台建立成果，填完 7 項資料、開團設定和開課表單送審，通過就公開。團費由協會與講師各分一半。` },
  { question: '參加好棋寶寶棋聚可以抵共學營嗎？', answer: '不行。棋聚與共學營是兩種不同的活動。' },
];
---
<BaseLayout title="AI 共學營常見問題" description="AI 共學營的開團方式、登記想學、團費、3 週實作、付款與退款、通知、作品公開與成為講師。" breadcrumbs={[{ name: 'AI 共學營', href: '/camp/' }, { name: '常見問題', href: '/camp/faq/' }]}>
  <div class="prose">
    <h1>AI 共學營常見問題</h1>
    <FAQ items={items} title="問與答" />
  </div>
</BaseLayout>
