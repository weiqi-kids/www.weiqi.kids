---
import AppLayout from '../../../../../layouts/AppLayout.astro';
import { getShowcase, slotsOf, saveFields, setSlots, submitForReview, missingItems, editable, archiveShowcase } from '../../../../../server/camp/showcases';
import { isAdmin } from '../../../../../server/camp/access';
import { notifyAdmins } from '../../../../../server/notify';
import { demoLinks } from '../../../../../server/camp/types';
import { str } from '../../../../../server/http';
import { parseTaipeiLocal, toTaipeiLocal, weekdayLabel } from '../../../../../lib/time';
import { SHOWCASE_STATUS, label } from '../../../../../lib/labels';
import { versionsOf, registerVersion, submitVersion, getVersion } from '../../../../../server/camp/versions';
import { fmtDateTime } from '../../../../../lib/time';
import { EXAMPLES } from '../../../../../lib/showcase-examples';
import { campRules } from '../../../../../data/site.js';
export const prerender = false;

const me = Astro.locals.account;
const id = Astro.params.id!;
const base = `/account/teach/showcases/${id}/`;
if (!me) return Astro.redirect(`/auth/login/?next=${encodeURIComponent(base)}`);
let s = await getShowcase(id);
if (!s || (s.owner_id !== me.id && !isAdmin(me))) return new Response('Not found', { status: 404 });
const step = ['1', '2', '3', '4', '5'].includes(Astro.url.searchParams.get('step') ?? '') ? Number(Astro.url.searchParams.get('step')) : 1;
let error: string | null = null;
let message: string | null = null;
let missing: string[] = [];

if (Astro.request.method === 'POST' && editable(s)) {
  const f = await Astro.request.formData();
  const action = str(f, 'action', 20);
  const t = (k: string, max = 5000) => str(f, k, max);
  if (action === 'step1') {
    const links = t('demo_links', 5000).split('\n').map((l) => l.split('|').map((x) => x.trim())).filter((p) => p[0] || p[1]);
    const bad = links.find((p) => !/^https?:\/\//.test(p[1] ?? ''));
    if (bad) error = `成果展示的網址要以 https:// 開頭：${bad.join(' | ')}`;
    else await saveFields(s, me.id, {
      title: t('title', 120), summary: t('summary', 300), instructor_name: t('instructor_name', 60) || me.display_name,
      demo_links: JSON.stringify(links.map((p) => ({ title: p[0] || p[1], url: p[1], note: p[2] ?? '' }))),
      before_after: t('before_after'), learner_outcome: t('learner_outcome'), audience: t('audience', 1000), prerequisites: t('prerequisites', 1000),
      instructor_bio: t('instructor_bio'), method: t('method', 20_000),
      sample_problem: t('sample_problem'), sample_cause: t('sample_cause'), sample_solutions: t('sample_solutions'), sample_flow: t('sample_flow'),
      setup_requirements: t('setup_requirements', 3000), repo_url: t('repo_url', 300), license: t('license', 500), allow_derivative: f.get('allow_derivative') === '1' ? 1 : 0,
    });
  } else if (action === 'step2') {
    const price = Number(t('price', 7));
    const min = Number(t('min_size', 3));
    const max = t('max_size', 3) ? Number(t('max_size', 3)) : null;
    const fixed = t('fixed_start', 20) ? parseTaipeiLocal(t('fixed_start', 20)) : null;
    if (!(price >= campRules.minFee)) error = `團費最低 ${campRules.minFee.toLocaleString('zh-TW')} 元。`;
    else if (!(min >= 1)) error = '開團人數至少 1 人。';
    else if (max !== null && !(max >= min)) error = '人數上限不能小於開團人數。';
    else {
      await saveFields(s, me.id, {
        teaching_format: t('teaching_format', 10) === 'onsite' ? 'onsite' : 'online', location: t('location', 200), price,
        schedule_mode: (['slots', 'vote', 'fixed'] as const).find((m) => m === t('schedule_mode', 10)) ?? 'slots', fixed_start: fixed,
        teaching_minutes: Math.min(480, Math.max(30, Number(t('teaching_minutes', 3)) || 120)),
        group_rule: t('group_rule', 10) === 'signup' ? 'signup' : 'paid', min_size: min, max_size: max,
        pay_days: Math.min(60, Math.max(1, Number(t('pay_days', 2)) || campRules.defaultPayDays)),
        vote_days: Math.min(30, Math.max(1, Number(t('vote_days', 2)) || campRules.defaultVoteDays)),
        forum_open: f.get('forum_open') === '1' ? 1 : 0,
      });
      const slots = [0, 1, 2, 3].map((i) => ({ weekday: Number(t(`slot_day_${i}`, 1)), start_time: t(`slot_time_${i}`, 5) }))
        .filter((x) => /^\d{2}:\d{2}$/.test(x.start_time) && x.weekday >= 0 && x.weekday <= 6);
      await setSlots(s.id, me.id, slots);
    }
  } else if (action === 'step3') {
    await saveFields(s, me.id, Object.fromEntries(['ttqs_needs', 'ttqs_goals', 'ttqs_outline', 'ttqs_hours', 'ttqs_methods', 'ttqs_evaluation', 'ttqs_expected'].map((k) => [k, t(k)])));
  } else if (action === 'register-version') {
    const r = await registerVersion(s, me.id, t('repo_url', 300) || s.repo_url, t('ref', 100), t('note', 500) || null);
    if (r.ok) message = `已登記版本 ${r.sha.slice(0, 7)}，確認後按「送審這個版本」。`; else error = r.error;
  } else if (action === 'submit-version') {
    const v = await getVersion(t('version', 60));
    error = v && v.showcase_id === s.id ? await submitVersion(v, s, me.id) : '找不到這個版本。';
    if (!error) message = '已送審，管理員審過後學員才會拿到這一版。';
  } else if (action === 'submit') {
    const r = await submitForReview(s, me.id);
    if (r.ok) message = '已送審，管理員審核後會通知你。'; else missing = r.missing;
  } else if (action === 'archive') {
    await archiveShowcase(s, me.id);
    message = '已下架。';
  }
  if (!error && action.startsWith('step') && s.status === 'published') await notifyAdmins('showcase.edited', `講師修改了已公開的成果「${s.title}」。`, `/camp/r/${s.slug}/`);
  if (!error && action.startsWith('step') && step < 4) return Astro.redirect(`${base}?step=${step + 1}`, 303);
  s = (await getShowcase(id))!;
}
const slots = await slotsOf(s.id);
const canEdit = editable(s);
if (step === 4 && !missing.length) missing = missingItems(s, slots);
const linksText = demoLinks(s).map((l) => [l.title, l.url, l.note].filter(Boolean).join(' | ')).join('\n');
const STEPS = ['成果與 8 項資料', '開團設定', 'TTQS 開課表單', '送審', 'GitHub 版本'];
const versions = await versionsOf(s.id);
const V_STATUS: Record<string, string> = { draft: '已登記，還沒送審', submitted: '審核中', approved: '審核通過', rejected: '沒有通過' };
const ex = EXAMPLES;
---
<AppLayout title={`成果：${s.title || '新成果'}`} breadcrumbs={[{ name: '講師後台', href: '/account/teach/' }, { name: s.title || '新成果', href: base }]}>
  <div class="prose">
    <h1>{s.title || '新成果'}</h1>
    <p class="muted">狀態：{label(SHOWCASE_STATUS, s.status)}{s.status === 'published' && <>．<a href={`/camp/r/${s.slug}/`}>看公開頁</a>．修改會直接生效，已開的團不受影響</>}{s.review_note && `．協會意見：${s.review_note}`}．<a href={`/camp/r/${s.slug}/`}>預覽</a>．<a href={`${base}materials/`}>技能單張</a></p>
    <nav class="steps">{STEPS.map((n, i) => <a href={`${base}?step=${i + 1}`} aria-current={step === i + 1 ? 'step' : undefined}>{i + 1}. {n}</a>)}</nav>
    {message && <p class="notice">{message}</p>}
    {error && <p class="notice notice-error">{error}</p>}
    {!canEdit && <p class="notice">{s.status === 'submitted' ? '審核中，暫時不能修改。' : '這項成果已下架。'}</p>}

    {step === 1 && (
      <form method="post">
        <input type="hidden" name="action" value="step1" />
        <p>這一頁的資料是學員決定要不要來學的依據，8 項都必填。灰字是協會成果的範例。</p>
        <div class="form-field"><label for="title">成果名稱</label><input id="title" name="title" value={s.title} placeholder={ex.title} required /></div>
        <div class="form-field"><label for="summary">一句話介紹</label><input id="summary" name="summary" value={s.summary} placeholder={ex.summary} required /></div>
        <div class="form-field"><label for="instructor_name">講師名稱（顯示在成果頁）</label><input id="instructor_name" name="instructor_name" value={s.instructor_name} required /></div>
        <div class="form-field"><label for="demo_links">1. 成果展示：一行一個，「名稱 | 網址 | 說明」</label><textarea id="demo_links" name="demo_links" rows="4" placeholder={ex.demo_links}>{linksText}</textarea><span class="form-hint">截圖或短片請先放到網路上（例如 YouTube），貼連結。</span></div>
        <div class="form-field"><label for="before_after">2. 用 AI 之前和之後，差在哪裡（數字或文字都可以）</label><textarea id="before_after" name="before_after" rows="3" placeholder={ex.before_after}>{s.before_after}</textarea></div>
        <div class="form-field"><label for="learner_outcome">3. 學完，學員能做出什麼</label><textarea id="learner_outcome" name="learner_outcome" rows="3" placeholder={ex.learner_outcome}>{s.learner_outcome}</textarea></div>
        <div class="form-field"><label for="audience">4. 適合誰</label><input id="audience" name="audience" value={s.audience} placeholder={ex.audience} /></div>
        <div class="form-field"><label for="prerequisites">4. 需要什麼基礎</label><input id="prerequisites" name="prerequisites" value={s.prerequisites} placeholder={ex.prerequisites} /></div>
        <div class="form-field"><label for="instructor_bio">5. 講師本業，以及為什麼做這個</label><textarea id="instructor_bio" name="instructor_bio" rows="4" placeholder={ex.instructor_bio}>{s.instructor_bio}</textarea></div>
        <div class="form-field"><label for="method">6. 做法說明（公開，讓學員自己試得到一半）</label><textarea id="method" name="method" rows="8" placeholder={ex.method}>{s.method}</textarea><span class="form-hint">可以用 Markdown。</span></div>
        <fieldset class="sheet">
          <legend>7. 試閱技能單張（公開，開團後學員拿到全部單張）</legend>
          <div class="form-field"><label for="sample_problem">問題</label><textarea id="sample_problem" name="sample_problem" rows="2" placeholder={ex.sample_problem}>{s.sample_problem}</textarea></div>
          <div class="form-field"><label for="sample_cause">發生的原因</label><textarea id="sample_cause" name="sample_cause" rows="2" placeholder={ex.sample_cause}>{s.sample_cause}</textarea></div>
          <div class="form-field"><label for="sample_solutions">解決方法有哪些</label><textarea id="sample_solutions" name="sample_solutions" rows="2" placeholder={ex.sample_solutions}>{s.sample_solutions}</textarea></div>
          <div class="form-field"><label for="sample_flow">我建議的流程</label><textarea id="sample_flow" name="sample_flow" rows="2" placeholder={ex.sample_flow}>{s.sample_flow}</textarea></div>
        </fieldset>
        <div class="form-field"><label for="setup_requirements">8. 自己跑起來要準備什麼（要哪些帳號、大概每月花多少錢、要不要信用卡）</label><textarea id="setup_requirements" name="setup_requirements" rows="3" placeholder={ex.setup_requirements}>{s.setup_requirements}</textarea></div>
        <div class="form-field"><label for="repo_url">你的做法所在的 GitHub repo（公開）</label><input id="repo_url" name="repo_url" value={s.repo_url} placeholder={ex.repo_url} /></div>
        <div class="form-field"><label for="license">授權</label><input id="license" name="license" value={s.license} placeholder={ex.license} /></div>
        <div class="form-field"><label><input type="checkbox" name="allow_derivative" value="1" checked={s.allow_derivative === 1} /> 允許學員把改好的版本公開放在自己的 GitHub</label></div>
        <p class="form-hint">上過的學員作品不用填：學員作品經你認可、作者同意公開後，會自動出現在成果頁。</p>
        {canEdit && <button class="btn" type="submit">儲存，下一步</button>}
      </form>
    )}

    {step === 2 && (
      <form method="post">
        <input type="hidden" name="action" value="step2" />
        <p>每團都是 1 堂主題教學加 3 週實作，為期 {campRules.duration}。系統會照這裡的設定自動開團。</p>
        <fieldset class="form-field"><legend>主題教學怎麼上</legend>
          <label><input type="radio" name="teaching_format" value="onsite" checked={s.teaching_format === 'onsite'} /> 實體上課</label>
          <label><input type="radio" name="teaching_format" value="online" checked={s.teaching_format === 'online'} /> 線上直播（連結開團後在講師後台貼）</label>
        </fieldset>
        <div class="form-field"><label for="location">實體地點（實體上課才填）</label><input id="location" name="location" value={s.location} /></div>
        <div class="form-field"><label for="teaching_minutes">主題教學多久（分鐘）</label><input id="teaching_minutes" name="teaching_minutes" type="number" min="30" max="480" value={s.teaching_minutes} /></div>
        <div class="form-field"><label for="price">團費（元，最低 {campRules.minFee.toLocaleString('zh-TW')}）</label><input id="price" name="price" type="number" min={campRules.minFee} step="100" value={s.price} required /><span class="form-hint">協會與你各分一半，結營後匯給你。</span></div>
        <fieldset class="form-field"><legend>主題教學的時間怎麼排</legend>
          <label><input type="radio" name="schedule_mode" value="slots" checked={s.schedule_mode === 'slots'} /> 我先填每週時段，學員登記時選；哪個時段先滿就開</label>
          <label><input type="radio" name="schedule_mode" value="vote" checked={s.schedule_mode === 'vote'} /> 滿人數後我提出候選日期，登記的人投票給我參考</label>
          <label><input type="radio" name="schedule_mode" value="fixed" checked={s.schedule_mode === 'fixed'} /> 我先訂好日期</label>
        </fieldset>
        <div class="form-field"><span class="label">每週時段（選第一種才填，台北時間）</span>
          {[0, 1, 2, 3].map((i) => (
            <div class="slot-row">
              <select name={`slot_day_${i}`} aria-label={`時段 ${i + 1} 星期`}>{[1, 2, 3, 4, 5, 6, 0].map((d) => <option value={d} selected={slots[i]?.weekday === d}>{weekdayLabel(d)}</option>)}</select>
              <input name={`slot_time_${i}`} type="time" value={slots[i]?.start_time ?? ''} aria-label={`時段 ${i + 1} 開始時間`} />
            </div>
          ))}
          <span class="form-hint">滿人數後，主題教學排在匯款期限之後最近的一次該時段。時間留空就是不用這一列。</span>
        </div>
        <div class="form-field"><label for="fixed_start">預訂日期（選第三種才填）</label><input id="fixed_start" name="fixed_start" type="datetime-local" value={toTaipeiLocal(s.fixed_start)} /></div>
        <fieldset class="form-field"><legend>成團條件</legend>
          <label><input type="radio" name="group_rule" value="paid" checked={s.group_rule === 'paid'} /> 匯款期限內付款滿人數才成團，沒滿自動退款</label>
          <label><input type="radio" name="group_rule" value="signup" checked={s.group_rule === 'signup'} /> 登記滿人數就成團，有付款的人上課</label>
        </fieldset>
        <div class="row">
          <div class="form-field"><label for="min_size">開團人數</label><input id="min_size" name="min_size" type="number" min="1" value={s.min_size} required /></div>
          <div class="form-field"><label for="max_size">人數上限（可不填）</label><input id="max_size" name="max_size" type="number" min="1" value={s.max_size ?? ''} /></div>
        </div>
        <div class="row">
          <div class="form-field"><label for="pay_days">滿人數後可以匯款幾天</label><input id="pay_days" name="pay_days" type="number" min="1" max="60" value={s.pay_days} /></div>
          <div class="form-field"><label for="vote_days">投票開放幾天</label><input id="vote_days" name="vote_days" type="number" min="1" max="30" value={s.vote_days} /></div>
        </div>
        <div class="form-field"><label><input type="checkbox" name="forum_open" value="1" checked={s.forum_open === 1} /> 開放公開討論區（學員自己試、卡住時可以發問）</label></div>
        {canEdit && <button class="btn" type="submit">儲存，下一步</button>}
      </form>
    )}

    {step === 3 && (
      <form method="post">
        <input type="hidden" name="action" value="step3" />
        <p>每一團都要符合 TTQS。這份表單只有協會看得到，會用在送評資料。</p>
        {([['ttqs_needs', '需求：學員遇到什麼問題'], ['ttqs_goals', '目標：學完能做到什麼'], ['ttqs_outline', '大綱'], ['ttqs_hours', '時數'], ['ttqs_methods', '教學方法'], ['ttqs_evaluation', '評量方式'], ['ttqs_expected', '預期成果']] as const).map(([k, n]) => (
          <div class="form-field"><label for={k}>{n}</label><textarea id={k} name={k} rows="3" placeholder={ex[k]}>{s![k]}</textarea></div>
        ))}
        {canEdit && <button class="btn" type="submit">儲存，下一步</button>}
      </form>
    )}

    {step === 5 && (
      <section>
        <p>學員的 AI 只會讀管理員審過的版本。你改了 repo 之後，登記新版本並送審；也可以請好棋寶寶講師 skill 幫你做。</p>
        {versions.length === 0 ? <p class="muted">還沒有登記任何版本。</p> : (
          <ul class="versions">{versions.map((v) => (
            <li><code>{v.commit_sha.slice(0, 7)}</code>．{V_STATUS[v.status]}．{fmtDateTime(v.created_at)}{v.note && `．${v.note}`}{v.review_note && `．協會意見：${v.review_note}`}
              {(v.status === 'draft' || v.status === 'rejected') && <form method="post" class="inline"><input type="hidden" name="action" value="submit-version" /><input type="hidden" name="version" value={v.id} /><button class="btn btn-ghost" type="submit">送審這個版本</button></form>}
            </li>
          ))}</ul>
        )}
        <form method="post">
          <input type="hidden" name="action" value="register-version" />
          <div class="form-field"><label for="vrepo">GitHub repo</label><input id="vrepo" name="repo_url" value={s.repo_url} required /></div>
          <div class="form-field"><label for="ref">版本（commit 或分支名，留空就用預設分支的最新版）</label><input id="ref" name="ref" /></div>
          <div class="form-field"><label for="vnote">這一版改了什麼（選填）</label><input id="vnote" name="note" maxlength="500" /></div>
          <button class="btn" type="submit">登記這個版本</button>
        </form>
      </section>
    )}

    {step === 4 && (
      <section>
        {missing.length > 0 ? (
          <div class="notice notice-error"><p>還缺這些才能送審：</p><ul>{missing.map((m) => <li>{m}</li>)}</ul></div>
        ) : s.status === 'draft' || s.status === 'changes_requested' ? <p>資料都齊了。送審後由協會管理員審核，通過就會公開並開始接受登記想學。</p> : null}
        {(s.status === 'draft' || s.status === 'changes_requested') && (
          <form method="post"><input type="hidden" name="action" value="submit" /><button class="btn" type="submit" disabled={missing.length > 0}>送審</button></form>
        )}
        {s.status === 'published' && (
          <form method="post" class="archive"><input type="hidden" name="action" value="archive" /><button class="link-button" type="submit">下架這項成果</button><span class="form-hint">下架後不再接受登記；已經開的團照常進行。</span></form>
        )}
      </section>
    )}
  </div>
</AppLayout>
<style>
  .steps { display: flex; flex-wrap: wrap; gap: var(--space-4); border-bottom: 1px solid var(--color-line); padding-bottom: var(--space-2); margin-bottom: var(--space-6); font-size: var(--text-sm); }
  .steps a[aria-current] { font-weight: 700; text-decoration: none; border-bottom: 3px solid var(--color-primary); }
  fieldset { border: 0; padding: 0; display: grid; gap: var(--space-2); }
  legend, .label { font-weight: 700; }
  .sheet { border: 1px solid var(--color-line); border-radius: var(--radius); padding: var(--space-4); margin-bottom: var(--space-4); }
  .slot-row { display: flex; gap: var(--space-2); margin-bottom: var(--space-2); }
  .row { display: grid; gap: var(--space-4); }
  @media (min-width: 640px) { .row { grid-template-columns: 1fr 1fr; } }
  .archive { margin-top: var(--space-8); display: grid; gap: var(--space-1); }
  .versions { display: grid; gap: var(--space-2); }
  .inline { display: inline; margin-left: var(--space-2); }
</style>
