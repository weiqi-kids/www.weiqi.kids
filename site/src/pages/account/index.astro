---
import AppLayout from '../../layouts/AppLayout.astro';
import { db, audit } from '../../server/db';
import { identitiesOf, membershipOf, isMembershipActive, unlinkIdentity } from '../../server/accounts';
import { requestMagicLink } from '../../server/magic-link';
import { lineEnabled } from '../../server/line';
import PushSettings from '../../components/PushSettings.astro';
import { clientIpHash, str } from '../../server/http';
import { fmtDate } from '../../lib/time';
import { ENROLLMENT_STATUS, COHORT_STATE, label } from '../../lib/labels';
export const prerender = false;

const me = Astro.locals.account;
if (!me) return Astro.redirect('/auth/login/?next=/account/');

let message: string | null = null;
let error: string | null = null;
let debugLink: string | undefined;
const linked = Astro.url.searchParams.get('linked');
if (linked) message = linked === 'line' ? '已綁定 LINE。' : '已綁定 Email。';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = str(form, 'action', 40);
  if (action === 'rename') {
    const name = str(form, 'display_name', 60);
    if (name) {
      await db().prepare('UPDATE accounts SET display_name = ? WHERE id = ?').bind(name, me.id).run();
      await audit(me.id, 'account.rename', me.id);
      me.display_name = name;
      message = '已更新顯示名稱。';
    }
  } else if (action === 'link-email') {
    const email = str(form, 'email', 120).toLowerCase();
    if (form.get('confirm') !== 'yes') error = '請勾選確認，才會綁定。';
    else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) error = '請填寫有效的 Email。';
    else {
      const r = await requestMagicLink({ email, purpose: 'link', accountId: me.id, ipHash: await clientIpHash(Astro.request), origin: Astro.url.origin });
      if (r.ok) { message = `確認信已寄到 ${email}，點信中連結即完成綁定。`; debugLink = r.debugLink; } else error = r.error;
    }
  } else if (action === 'unlink') {
    const provider = str(form, 'provider', 10) === 'line' ? 'line' : 'email';
    message = (await unlinkIdentity(me.id, provider)) ? '已解除綁定。' : null;
    if (!message) error = '至少要保留一種登入方式。';
  } else if (action === 'read-notifications') {
    await db().prepare('UPDATE notifications SET read_at = ? WHERE account_id = ? AND read_at IS NULL').bind(new Date().toISOString(), me.id).run();
  }
}

const identities = await identitiesOf(me.id);
const emailIdentity = identities.find((i) => i.provider === 'email');
const lineIdentity = identities.find((i) => i.provider === 'line');
const membership = await membershipOf(me.id);
const { results: wants } = await db().prepare(
  `SELECT s.title, s.slug, s.min_size, c.id AS cohort_id, c.state, (SELECT COUNT(*) FROM interests x WHERE x.cohort_id = c.id) AS n
   FROM interests i JOIN cohorts c ON c.id = i.cohort_id JOIN showcases s ON s.id = c.showcase_id
   WHERE i.account_id = ? AND c.state IN ('gathering', 'scheduling', 'payment') ORDER BY i.created_at DESC`,
).bind(me.id).all<{ title: string; slug: string; min_size: number; cohort_id: string; state: string; n: number }>();
const { results: mine } = await db().prepare(
  `SELECT e.code, e.status, e.amount, s.title, c.id AS cohort_id, c.seq, c.state, c.teaching_start
   FROM enrollments e JOIN cohorts c ON c.id = e.cohort_id JOIN showcases s ON s.id = c.showcase_id
   WHERE e.account_id = ? AND e.status != 'cancelled' ORDER BY e.created_at DESC`,
).bind(me.id).all<{ code: string; status: string; amount: number; title: string; cohort_id: string; seq: number; state: string; teaching_start: string | null }>();
const { results: notes } = await db().prepare('SELECT message, link, created_at, read_at FROM notifications WHERE account_id = ? ORDER BY created_at DESC LIMIT 30').bind(me.id).all<{ message: string; link: string | null; created_at: string; read_at: string | null }>();
const teaching = (await db().prepare('SELECT COUNT(*) AS n FROM showcases WHERE owner_id = ?').bind(me.id).first<{ n: number }>())?.n ?? 0;
const d = (iso: string) => fmtDate(iso);

---
<AppLayout title="帳號">
  <div class="prose">
    <h1>帳號</h1>
    {message && <p class="notice">{message}</p>}
    {debugLink && <p class="notice">測試環境：寄信服務尚未啟用，請直接使用這個連結：<a href={debugLink}>{debugLink}</a></p>}
    {error && <p class="notice notice-error">{error}</p>}

    <section>
      <h2>通知</h2>
      {notes.length === 0 ? <p class="muted">沒有通知。</p> : (
        <>
          <ul>{notes.map((n) => <li class={n.read_at ? 'muted' : ''}>{d(n.created_at)}：{n.link ? <a href={n.link}>{n.message}</a> : n.message}</li>)}</ul>
          <form method="post"><input type="hidden" name="action" value="read-notifications" /><button class="link-button" type="submit">全部標為已讀</button></form>
        </>
      )}
    </section>

    <PushSettings />

    <section>
      <h2>我登記想學的</h2>
      {wants.length === 0 ? <p>還沒有登記。<a href="/camp/">看講師成果</a></p> : (
        <ul>{wants.map((w) => <li><a href={w.state === 'gathering' ? `/camp/r/${w.slug}/` : `/camp/g/${w.cohort_id}/`}>{w.title}</a>：{w.state === 'gathering' ? `已登記 ${w.n}／${w.min_size} 人` : `${label(COHORT_STATE, w.state)}，請到團頁${w.state === 'payment' ? '報名匯款' : '看進度'}`}</li>)}</ul>
      )}
    </section>

    <section>
      <h2>我的團</h2>
      {mine.length === 0 ? <p class="muted">還沒有報名。</p> : (
        <ul>{mine.map((e) => <li><a href={e.status === 'confirmed' ? `/camp/g/${e.cohort_id}/room/` : `/camp/g/${e.cohort_id}/`}>{e.title}．第 {e.seq} 團</a>：{label(COHORT_STATE, e.state)}．{label(ENROLLMENT_STATUS, e.status)}（報名編號 <code>{e.code}</code>）</li>)}</ul>
      )}
    </section>

    <section>
      <h2>會員與講師</h2>
      {membership && isMembershipActive(membership)
        ? <p>協會會員，{membership.lifetime === 1 ? '不會到期' : `有效到 ${d(membership.expires_at)}`}。<a href="/account/teach/">講師後台</a>（{teaching} 項成果）{membership.lifetime !== 1 && <>．<a href="/account/membership/">續會</a></>}</p>
        : <p>{membership ? `會員已在 ${d(membership.expires_at)} 到期。` : '還不是協會會員。'}上課不需要入會；想把自己的成果放上來當講師，要先<a href="/account/membership/">繳常年會費</a>。</p>}
    </section>
    <h2>登入方式</h2>
    <ul>
      <li>Email：{emailIdentity ? <>{emailIdentity.subject} {lineIdentity && <form class="inline" method="post"><input type="hidden" name="action" value="unlink" /><input type="hidden" name="provider" value="email" /><button class="link-button" type="submit">解除綁定</button></form>}</> : '尚未綁定'}</li>
      <li>LINE：{lineIdentity ? <>已綁定 {emailIdentity && <form class="inline" method="post"><input type="hidden" name="action" value="unlink" /><input type="hidden" name="provider" value="line" /><button class="link-button" type="submit">解除綁定</button></form>}</> : (lineEnabled() ? <a href="/auth/line/?link=1">綁定 LINE</a> : '尚未開放')}</li>
    </ul>
    {!emailIdentity && (
      <form method="post">
        <input type="hidden" name="action" value="link-email" />
        <div class="form-field">
          <label for="email">綁定 Email</label>
          <input id="email" name="email" type="email" required />
        </div>
        <div class="form-field"><label><input type="checkbox" name="confirm" value="yes" required /> 我確認這個 Email 是我本人的，要綁定到目前這個帳號。</label></div>
        <button class="btn btn-ghost" type="submit">寄送確認信</button>
      </form>
    )}

    <h2>顯示名稱</h2>
    <form method="post">
      <input type="hidden" name="action" value="rename" />
      <div class="form-field"><label for="display_name">在課程論壇顯示的名稱</label><input id="display_name" name="display_name" value={me.display_name} maxlength="60" required /></div>
      <button class="btn btn-ghost" type="submit">儲存</button>
    </form>
  </div>
</AppLayout>
<style>
  .inline { display: inline; }
  section { margin-bottom: var(--space-8); }
</style>
