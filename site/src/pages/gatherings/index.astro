---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { fmtLongDate as fmtDate } from '../../lib/time';
const now = new Date();
const upcoming = (await getCollection('gatherings')).filter((g) => g.data.startDate >= now).sort((a, b) => a.data.startDate.getTime() - b.data.startDate.getTime());
---
<BaseLayout title="好棋寶寶棋聚" description="台灣好棋寶寶協會的圍棋交流活動：實體聚會、主題講座、友誼對局與新手交流。不需要共學營會員資格。" breadcrumbs={[{ name: '好棋寶寶棋聚', href: '/gatherings/' }]}>
  <div class="prose">
    <div class="page-head">
      <h1>好棋寶寶棋聚</h1>
      <figure>
        <img class="page-hero" src="/media/illustrations/gatherings-index.webp" alt="立牌寫著目前沒有排定場次，牆上月曆空白，桌上棋子已收進棋罐，旁邊放 LINE 通知牌" width="1600" height="900" loading="eager" fetchpriority="high" />
        <figcaption>棋聚目前沒有排定場次，恢復舉辦會先在 LINE 社群公布</figcaption>
      </figure>
    </div>
    <div class="key-answer" data-question="好棋寶寶棋聚是什麼？">
      <p>好棋寶寶棋聚是協會辦的圍棋交流活動，內容包含實體聚會、主題講座、友誼對局與新手交流。2023 到 2024 年在台中固定舉辦，目前沒有排定新的場次；協會現階段的聚會以 <a href="/camp/">AI 共學營</a>為主。</p>
    </div>
  </div>
  <ul class="card-grid cols-3">
    <li><a class="card" href="/gatherings/about/"><h2>棋聚介紹</h2><p>棋聚的形式、適合誰、怎麼參加。</p></a></li>
    <li><a class="card" href="/gatherings/upcoming/"><h2>即將舉辦</h2><p>{upcoming.length ? `${upcoming.length} 場即將舉辦` : '目前沒有公告的場次'}</p></a></li>
    <li><a class="card" href="/gatherings/archive/"><h2>歷史棋聚</h2><p>親子圍棋嘉年華、全國圍棋公開賽、好棋同樂會。</p></a></li>
  </ul>
  {upcoming.length > 0 && (
    <section>
      <h2>近期場次</h2>
      <ul>{upcoming.map((g) => <li><a href={`/gatherings/${g.data.slug}/`}>{fmtDate(g.data.startDate)}．{g.data.title}</a></li>)}</ul>
    </section>
  )}
</BaseLayout>
<style>
  .page-head { display: grid; gap: var(--space-4) var(--space-6); align-items: center; margin-bottom: var(--space-6); }
  @media (min-width: 640px) { .page-head { grid-template-columns: minmax(0, 1fr) 20rem; } }
  .page-head h1 { margin: 0; }
  .page-head figure { margin: 0; }
  .page-head figcaption { margin-top: var(--space-2); font-size: var(--text-xs); line-height: 1.6; color: var(--color-ink-muted); }
  .page-hero { width: 100%; max-width: 20rem; height: auto; border-radius: var(--radius); }

</style>
