---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { requireAdmin } from '../../server/guard';
import { db } from '../../server/db';
export const prerender = false;
const stop = requireAdmin(Astro); if (stop) return stop;
const n = async (sql: string) => (await db().prepare(sql).first<{ n: number }>())?.n ?? 0;
const todo = [
  { n: await n("SELECT COUNT(*) AS n FROM showcases WHERE status = 'submitted'"), title: '成果待審核', text: '講師送審的成果與開課表單。', href: '/admin/showcases/' },
  { n: await n("SELECT COUNT(*) AS n FROM skill_versions WHERE status = 'submitted'"), title: '版本待審核', text: '講師 GitHub 上的新版本，審過學員的 AI 才會讀到。', href: '/admin/versions/' },
  { n: await n("SELECT COUNT(*) AS n FROM enrollments WHERE status = 'submitted'"), title: '待核款', text: '學員填了匯款資料，等你對照銀行入帳。', href: '/admin/payments/' },
  { n: await n("SELECT COUNT(*) AS n FROM enrollments WHERE status = 'refund_pending'"), title: '待退款', text: '沒成團、講師取消或開課前申請退款。', href: '/admin/payments/#refunds' },
  { n: await n("SELECT COUNT(*) AS n FROM membership_dues WHERE status = 'submitted'"), title: '會費待核', text: '入會與續會的匯款。', href: '/admin/payments/#dues' },
  { n: await n("SELECT COUNT(*) AS n FROM payouts WHERE status = 'due'"), title: '分潤待匯', text: '已結營的團，講師應得一半團費。', href: '/admin/payouts/' },
  { n: await n("SELECT COUNT(*) AS n FROM appeals WHERE status = 'open'"), title: '申訴', text: '內容被隱藏的作者申訴。', href: '/admin/moderation/' },
];
---
<AdminLayout title="待辦">
  <p>開團、排時間、成團、結營都由系統自動處理。只有下面這幾種事需要你。</p>
  <ul class="card-grid cols-3">
    {todo.map((t) => <li><a class="card todo" href={t.href}><span class="big">{t.n}</span><h2>{t.title}</h2><p>{t.text}</p></a></li>)}
  </ul>
</AdminLayout>
<style>
  .todo { display: grid; gap: var(--space-1); }
  .big { font-size: var(--text-2xl); font-weight: 800; color: var(--color-accent); line-height: 1; }
</style>
