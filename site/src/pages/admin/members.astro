---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { requireAdmin } from '../../server/guard';
import { db } from '../../server/db';
import { extendMembership } from '../../server/admin';
import { str } from '../../server/http';
export const prerender = false;
const stop = requireAdmin(Astro); if (stop) return stop;
const me = Astro.locals.account!;
let message: string | null = null;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (str(form, 'action', 20) === 'renew') { await extendMembership(str(form, 'account', 60), me.id); message = '已續會一年。'; }
}
const { results } = await db().prepare(
  `SELECT a.id, a.display_name, a.is_admin, m.started_at, m.expires_at,
     (SELECT GROUP_CONCAT(provider || ':' || subject, ', ') FROM login_identities i WHERE i.account_id = a.id) AS logins,
     (SELECT GROUP_CONCAT(course_slug, ', ') FROM course_access c WHERE c.account_id = a.id) AS courses
   FROM accounts a LEFT JOIN memberships m ON m.account_id = a.id ORDER BY a.created_at DESC LIMIT 500`,
).all<{ id: string; display_name: string; is_admin: number; started_at: string | null; expires_at: string | null; logins: string | null; courses: string | null }>();
const now = new Date().toISOString();
---
<AdminLayout title="會員與帳號">
  {message && <p class="notice">{message}</p>}
  <p>續會款項經 LINE@ 確認後，按「續會一年」。續會沿用原帳號，不刪除任何紀錄。</p>
  <table class="admin-table">
    <thead><tr><th>帳號</th><th>登入方式</th><th>會員效期</th><th>已開通課程</th><th>操作</th></tr></thead>
    <tbody>
      {results.map((a) => (
        <tr>
          <td>{a.display_name}{a.is_admin === 1 && '（管理員）'}<br /><code>{a.id}</code></td>
          <td>{a.logins}</td>
          <td>{a.expires_at ? `${a.started_at!.slice(0, 10)}～${a.expires_at.slice(0, 10)}${a.expires_at < now ? '（已到期）' : ''}` : '非會員'}</td>
          <td>{a.courses}</td>
          <td>{a.expires_at && <form method="post"><input type="hidden" name="action" value="renew" /><input type="hidden" name="account" value={a.id} /><button class="link-button" type="submit">續會一年</button></form>}</td>
        </tr>
      ))}
    </tbody>
  </table>
</AdminLayout>
