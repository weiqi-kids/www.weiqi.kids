---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { requireAdmin } from '../../server/guard';
import { db } from '../../server/db';
import { fmtDate } from '../../lib/time';
export const prerender = false;
const stop = requireAdmin(Astro); if (stop) return stop;
const { results } = await db().prepare(
  `SELECT a.id, a.display_name, a.is_admin, a.created_at, m.expires_at,
     (SELECT GROUP_CONCAT(CASE provider WHEN 'line' THEN 'LINE' ELSE subject END, '、') FROM login_identities i WHERE i.account_id = a.id) AS logins,
     (SELECT COUNT(*) FROM showcases s WHERE s.owner_id = a.id AND s.status = 'published') AS showcases,
     (SELECT COUNT(*) FROM enrollments e WHERE e.account_id = a.id AND e.status = 'confirmed') AS cohorts
   FROM accounts a LEFT JOIN memberships m ON m.account_id = a.id ORDER BY a.created_at DESC LIMIT 500`,
).all<{ id: string; display_name: string; is_admin: number; created_at: string; expires_at: string | null; logins: string | null; showcases: number; cohorts: number }>();
const now = new Date().toISOString();
---
<AdminLayout title="帳號">
  <table class="admin-table">
    <thead><tr><th>名稱</th><th>登入方式</th><th>會員</th><th>公開成果</th><th>上過的團</th><th>建立</th></tr></thead>
    <tbody>{results.map((r) => (
      <tr><td>{r.display_name}{r.is_admin === 1 && '（管理員）'}</td><td>{r.logins}</td><td>{r.expires_at ? `${r.expires_at > now ? '有效' : '已到期'}，${fmtDate(r.expires_at)}` : '—'}</td><td>{r.showcases}</td><td>{r.cohorts}</td><td>{fmtDate(r.created_at)}</td></tr>
    ))}</tbody>
  </table>
</AdminLayout>
