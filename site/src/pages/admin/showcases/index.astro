---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { requireAdmin } from '../../../server/guard';
import { db } from '../../../server/db';
import { fmtDateTime } from '../../../lib/time';
import { SHOWCASE_STATUS, label } from '../../../lib/labels';
export const prerender = false;
const stop = requireAdmin(Astro); if (stop) return stop;
const { results } = await db().prepare(
  `SELECT s.id, s.slug, s.title, s.status, s.updated_at, s.instructor_name FROM showcases s
   ORDER BY CASE s.status WHEN 'submitted' THEN 0 WHEN 'changes_requested' THEN 1 WHEN 'draft' THEN 2 WHEN 'published' THEN 3 ELSE 4 END, s.updated_at DESC`,
).all<{ id: string; slug: string; title: string; status: string; updated_at: string; instructor_name: string }>();
---
<AdminLayout title="成果審核">
  <table class="admin-table">
    <thead><tr><th>成果</th><th>講師</th><th>狀態</th><th>更新</th></tr></thead>
    <tbody>{results.map((s) => <tr><td><a href={`/admin/showcases/${s.id}/`}>{s.title || '（未命名）'}</a></td><td>{s.instructor_name}</td><td>{label(SHOWCASE_STATUS, s.status)}</td><td>{fmtDateTime(s.updated_at)}</td></tr>)}</tbody>
  </table>
</AdminLayout>
