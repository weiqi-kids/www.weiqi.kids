---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { requireAdmin } from '../../server/guard';
import { getCollection } from 'astro:content';
import { interestTotals, openGroups } from '../../server/interests';
export const prerender = false;
const stop = requireAdmin(Astro); if (stop) return stop;
const showcases = (await getCollection('topics')).sort((a, b) => a.data.order - b.data.order);
const totals = await interestTotals();
const rows = await Promise.all(showcases.map(async (s) => ({ s: s.data, n: totals.get(s.data.slug) ?? 0, groups: await openGroups(s.data.slug) })));
---
<AdminLayout title="登記想學">
  <p>登記人數到開團人數時，管理員會收到通知。開團方式：和講師確定日期後，建立這個成果的正式課程；登記的人會在帳號頁看到報名連結。</p>
  <table class="admin-table">
    <thead><tr><th>講師成果</th><th>講師</th><th>已登記／開團人數</th><th>狀態</th></tr></thead>
    <tbody>
      {rows.map(({ s, n, groups }) => (
        <tr>
          <td><a href={`/camp/topics/${s.slug}/`}>{s.title}</a></td>
          <td>{s.instructors.join('、')}</td>
          <td>{n}／{s.groupSize}</td>
          <td>{groups.length ? `已開團：${groups.map((c) => c.data.title).join('、')}` : n >= s.groupSize ? '已滿額，待開團' : '登記中'}</td>
        </tr>
      ))}
    </tbody>
  </table>
</AdminLayout>
