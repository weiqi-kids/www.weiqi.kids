---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { requireAdmin } from '../../server/guard';
import { db } from '../../server/db';
import { fmtDateTime } from '../../lib/time';
import { AUDIT_ACTION } from '../../lib/labels';
export const prerender = false;
const stop = requireAdmin(Astro); if (stop) return stop;
const { results } = await db().prepare(
  `SELECT l.created_at, l.action, l.target, l.detail, a.display_name AS actor, t.display_name AS target_name, s.title AS showcase_title
   FROM audit_log l LEFT JOIN accounts a ON a.id = l.actor_id LEFT JOIN accounts t ON t.id = l.target LEFT JOIN showcases s ON s.id = l.target
   ORDER BY l.id DESC LIMIT 300`,
).all<{ created_at: string; action: string; target: string | null; detail: string | null; actor: string | null; target_name: string | null; showcase_title: string | null }>();
const detailText = (raw: string | null) => {
  if (!raw) return '';
  try {
    const d = JSON.parse(raw) as Record<string, unknown>;
    return [d.reason && `原因：${d.reason}`, d.note && `說明：${d.note}`, typeof d.amount === 'number' && `${d.amount.toLocaleString('zh-TW')} 元`, d.provider && (d.provider === 'line' ? 'LINE' : 'Email')].filter(Boolean).join('．');
  } catch { return ''; }
};
---
<AdminLayout title="操作紀錄">
  <p>時間為台北時間，列出最近 300 筆。</p>
  <table class="admin-table">
    <thead><tr><th>時間</th><th>操作者</th><th>動作</th><th>對象</th><th>補充</th></tr></thead>
    <tbody>{results.map((r) => (
      <tr><td>{fmtDateTime(r.created_at)}</td><td>{r.actor ?? '系統'}</td><td>{AUDIT_ACTION[r.action] ?? '其他操作'}</td><td>{r.target_name ?? r.showcase_title ?? ''}</td><td>{detailText(r.detail)}</td></tr>
    ))}</tbody>
  </table>
</AdminLayout>
