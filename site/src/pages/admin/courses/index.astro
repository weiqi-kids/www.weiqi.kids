---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { requireAdmin } from '../../../server/guard';
import { db } from '../../../server/db';
import { runtimeCourses } from '../../../server/courses';
import { addInstructor } from '../../../server/admin';
import { str } from '../../../server/http';
export const prerender = false;
const stop = requireAdmin(Astro); if (stop) return stop;
const me = Astro.locals.account!;
let message: string | null = null;
let error: string | null = null;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const r = await addInstructor(str(form, 'course', 100), str(form, 'account', 60), me.id, str(form, 'override', 500) || null);
  if (r.ok) message = '已加入講師。'; else error = r.error;
}
const courses = await runtimeCourses();
const { results: staff } = await db().prepare('SELECT s.course_slug, a.display_name, a.id FROM course_staff s JOIN accounts a ON a.id = s.account_id').all<{ course_slug: string; display_name: string; id: string }>();
---
<AdminLayout title="課程講師">
  {message && <p class="notice">{message}</p>}
  {error && <p class="notice notice-error">{error}</p>}
  <p>課程內容（日期、場次、說明）由講師與協會填寫開課表單後，寫入 <code>site/src/content/courses/</code> 並部署。這裡指定每門課的講師帳號，講師即為該課論壇的版主。</p>
  {courses.length === 0 && <p>目前沒有課程。</p>}
  {courses.map((c) => (
    <section>
      <h2>{c.data.title}（{c.data.status}）</h2>
      <p><a href={`/admin/courses/${c.data.slug}/evidence.csv`}>下載 TTQS 佐證索引（CSV）</a></p>
      <p>講師帳號：{staff.filter((s) => s.course_slug === c.data.slug).map((s) => s.display_name).join('、') || '尚未指定'}</p>
      <form method="post">
        <input type="hidden" name="course" value={c.data.slug} />
        <div class="form-field"><label>帳號 ID（從「會員」頁複製）</label><input name="account" required /></div>
        <div class="form-field"><label>例外理由（沒有已核准講師申請時必填，例如第一門課試點講師）</label><input name="override" /></div>
        <button class="btn btn-ghost" type="submit">加入講師</button>
      </form>
    </section>
  ))}
</AdminLayout>
