---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, courseRules, association } from '../../data/site.js';
import { founders } from '../../data/legacy/members.js';
import YouTube from '../../components/YouTube.astro';
import { videos, channelUrl } from '../../data/media.js';
---
<BaseLayout title="協會介紹" description="台灣好棋寶寶協會的會員組成、主辦的好棋寶寶棋聚與 AI 共學營、會員制度與聯絡方式。" breadcrumbs={[{ name: '協會', href: '/association/' }, { name: '協會介紹', href: '/association/about/' }]}>
  <article class="prose">
    <h1>協會介紹</h1>
    <div class="key-answer" data-question="台灣好棋寶寶協會在做什麼？">
      <p>{site.legalName}（{site.alternateName}）於 2024 年 1 月 5 日成立，由一群因圍棋結緣的各行各業人士組成，目前有 {founders.length} 位成員。協會以「{association.purpose}」為宗旨，主辦好棋寶寶棋聚與 AI 共學營，並整理圍棋與 AI 的公開知識。</p>
    </div>

    <h2>立案資料</h2>
    <dl class="facts">
      <dt>團體名稱</dt><dd>{site.legalName}</dd>
      <dt>成立日期</dt><dd>2024 年 1 月 5 日（民國 113 年 1 月 5 日）</dd>
      <dt>立案</dt><dd>內政部 2024 年 2 月 20 日核准，{association.registrationNo}</dd>
      <dt>法人登記</dt><dd>2024 年 2 月 29 日，{association.courtCaseNo}</dd>
      <dt>會址</dt><dd>{association.address}</dd>
      <dt>理事長</dt><dd><a href={`/association/members/${association.chairman.slug}/`}>{association.chairman.name}</a>（第 1 屆，任期 {association.chairman.term}）</dd>
      <dt>組織</dt><dd>理事 {association.board.directors} 人、監事 {association.board.supervisors} 人，任期 {association.board.term} 年</dd>
    </dl>

    <p><a href="/association/registration/">看立案證書、負責人當選證明書與內政部核准函全文</a></p>

    <h2>協會任務</h2>
    <p>依<a href="/association/charter/">章程</a>第三條，協會的任務有四項：</p>
    <ol>{association.missions.map((m) => <li>{m}</li>)}</ol>

    <h2>協會主辦的兩種活動</h2>
    <div class="key-answer" data-question="好棋寶寶棋聚和 AI 共學營有什麼不同？">
      <p>好棋寶寶棋聚是以圍棋交流為主的聚會，包含主題講座、友誼對局與新手交流。AI 共學營是會員的付費課程，每門課 1 堂主題教學加 3 堂實作，為期{courseRules.duration}。</p>
    </div>
    <ul>
      <li><a href="/gatherings/">好棋寶寶棋聚</a></li>
      <li><a href="/camp/">AI 共學營</a></li>
    </ul>

    <h2>會員制度</h2>
    <div class="key-answer" data-question="怎麼成為協會會員？">
      <p>依<a href="/association/charter/">章程</a>第七條，個人會員入會費 0 元、常年會費 {courseRules.fee.toLocaleString('zh-TW')} 元，這筆常年會費已包含一門 AI 共學營課程；之後每上一門新課再付 {courseRules.fee.toLocaleString('zh-TW')} 元。企業會員入會費 0 元、常年會費 60,000 元（見<a href="/association/corporate-membership/">企業會員</a>）。</p>
    </div>

    <h2>公開知識</h2>
    <p>協會把圍棋入門、圍棋歷史、AlphaGo 與 KataGo 的原理整理成<a href="/knowledge/">公開知識</a>，任何人都可以閱讀；共學營講師可以引用，但完整課程教材只提供給該課參與者。</p>

    <h2>吉祥物：狐狸與狸貓</h2>
    <p>好棋寶寶的吉祥物是狐狸與狸貓。第一屆親子圍棋嘉年華的舞台主視覺就是牠們，協會 YouTube 頻道也有牠們對弈的短片。</p>
    <div class="mascots">
      <img src="/media/brand/mascot-fox.webp" alt="好棋寶寶吉祥物：拿著扇子的狐狸" width="761" height="596" loading="lazy" />
      <img src="/media/brand/mascot-raccoon.webp" alt="好棋寶寶吉祥物：拋出書本的狸貓" width="716" height="701" loading="lazy" />
    </div>

    <h2>推廣影片</h2>
    <YouTube {...videos.promo} />
    <p>更多影片在協會 <a href={channelUrl} rel="noopener">YouTube 頻道</a>，也可以看<a href="/association/activities/videos/">影片整理</a>。</p>

    <h2>聯絡協會</h2>
    <p>Email：<a href={`mailto:${site.email}`}>{site.email}</a></p>
  </article>
</BaseLayout>
<style>
  .mascots { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); align-items: end; margin-bottom: var(--space-6); }
  .mascots img { width: 100%; height: auto; }
</style>
