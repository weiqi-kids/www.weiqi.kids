---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site.js';

// 全文謄錄自協會章程掃描本（內政部 113 年 2 月台內團字第 1130005685 號函准予備查）。
// 條號、用字與分項一律照原件，未做潤飾。
const chapters = [
  {
    title: '第一章　總則',
    articles: [
      { n: '第一條', paras: ['本會名稱為台灣好棋寶寶協會（以下簡稱本會）。'] },
      { n: '第二條', paras: ['本會為依法設立、非以營利為目的之公益性社會團體，以成為圍棋文化前進的推手為宗旨。'] },
      {
        n: '第三條',
        paras: ['本會之任務如下，並依相關法令規定推動及執行：'],
        items: [
          '一、各城市棋友交流，以圍棋為載體，提升不同文化包容性。',
          '二、圍棋授課教材升級。',
          '三、促進圍棋與其他產業交流活動。',
          '四、專業、職業棋手投入公益活動。',
        ],
      },
      { n: '第四條', paras: ['本會之主管機關為內政部，本會之目的事業應受各該事業主管機關之指導、監督。'] },
      { n: '第五條', paras: ['本會以全國行政區域為組織區域。'] },
      {
        n: '第六條',
        paras: [
          '本會會址設於主管機關所轄地區，並得報經主管機關核准設分支機構。',
          '前項分支機構組織簡則經會員（會員代表）大會通過，報請主管機關核准後行之。',
          '會址及分支機構之地址於設置及變更時，應函報主管機關核備。',
        ],
      },
    ],
  },
  {
    title: '第二章　會員、理事及監事',
    articles: [
      {
        n: '第七條',
        paras: ['本會會員及會費分類如下：'],
        items: [
          '一、個人會員：凡贊同本會宗旨、對圍棋具有熱忱者，填具入會申請書，經理事會審查通過，並繳納會費後，為個人會員；入會費新臺幣 0 元，於會員入會時繳納；常年會費 6,000 元。',
          '二、企業會員：凡贊同本會宗旨之機構或團體，填具入會申請書，經理事會審查通過，並繳納會費後，為企業會員，企業會員推派代表 1 人，以行使會員權利；入會費新臺幣 0 元，於會員入會時繳納；常年會費 60,000 元。',
          '三、贊助會員：凡贊同本會宗旨且贊助本會經費、資源之個人或團體，填具入會申請書，經理事會審查通過後，為贊助會員。',
        ],
      },
      {
        n: '第八條',
        paras: [
          '會員（會員代表）有表決權、選舉權、被選舉權與罷免權。每一會員（會員代表）為一權。',
          '贊助會員，無前項權利。',
        ],
      },
      { n: '第九條', paras: ['本會理事及監事，任期 4 年。'] },
      { n: '第十條', paras: ['本會置理事 9 人（其中 1 人為理事長）。', '理事長，由全體理事中選舉之。'] },
      {
        n: '第十一條',
        paras: [
          '本會置監事 3 人（其中 1 人為常務監事）。',
          '監事會置常務監事，由監事互選之，監察日常會務，並擔任監事會主席。',
        ],
      },
      {
        n: '第十二條',
        paras: [
          '會員有遵守本會章程、決議及繳納會費之義務。',
          '會員未繳納會費者，不得享有會員權利，連續 2 年未繳納會費者，視為自動退會。會員經出會、退會或停權處分，如欲申請復會或復權時，除有正當理由經理事會審核通過者外，應繳清前所積欠之會費。',
        ],
      },
      { n: '第十三條', paras: ['會員（會員代表）有違反法令、章程或不遵守會員大會決議時，得經理事會決議，予以警告或停權處分，其危害團體情節重大者，得經會員大會決議予以除名。'] },
      {
        n: '第十四條',
        paras: ['會員有下列情事之一者，為出會：'],
        items: ['一、死亡。', '二、喪失會員資格者。', '三、經會員（會員代表）大會決議除名者。'],
      },
      { n: '第十五條', paras: ['會員得以書面敘明理由向本會聲明退會。'] },
    ],
  },
  {
    title: '第三章　組織及職權',
    articles: [
      { n: '第十六條', paras: ['本會以會員大會為最高權力機構。會員（會員代表）人數超過 300 人以上者，得分區比例選出會員代表，再合開會員代表大會，行使會員大會職權。會員代表任期與理事、監事相同，其名額及選舉辦法由理事會通過後實施，並報主管機關備查。'] },
      {
        n: '第十七條',
        paras: ['會員（會員代表）大會之職權如下：'],
        items: [
          '一、訂定與變更章程。',
          '二、選舉及罷免理事、監事。',
          '三、議決入會費、常年會費、事業費及會員捐款之數額及方式。',
          '四、議決年度工作計畫、報告及預算、決算。',
          '五、議決會員（會員代表）之除名處分。',
          '六、議決財產之買賣、轉讓或他項權利設定等處分。',
          '七、議決本會之解散。',
          '八、議決與會員權利義務有關之其他重大事項。',
        ],
        after: ['前項第八款重大事項之範圍由理事會定之。'],
      },
      {
        n: '第十八條',
        paras: [
          '本會理事、監事，由會員（會員代表）選舉之，分別成立理事會、監事會。',
          '選舉前項理事、監事時，依計票情形得同時選出候補理事，候補監事，遇理事、監事出缺時，分別依序遞補之。',
          '理事會得提出下屆理事、監事候選人參考名單。',
          '理事、監事得採用通訊選舉。通訊選舉辦法由理事會通過後實施，並報主管機關備查。',
        ],
      },
      {
        n: '第十九條',
        paras: [
          '理事長對內綜理督導會務，對外代表本會，並擔任會員大會、理事會主席。',
          '理事長因事不能執行職務時，應指定理事 1 人代理之，未指定或不能指定時，由理事互推 1 人代理之。',
          '理事長出缺時，應於 1 個月內補選之。',
        ],
      },
      {
        n: '第二十條',
        paras: ['理事會之職權如下：'],
        items: [
          '一、審定會員（會員代表）之資格。',
          '二、選舉及罷免理事、理事長。',
          '三、議決理事、理事長之辭職。',
          '四、聘免工作人員。',
          '五、擬訂年度工作計畫、報告及預算、決算。',
          '六、得提出下屆理事、監事候選人參考名單。',
          '七、其他應執行事項。',
        ],
      },
      {
        n: '第二十一條',
        paras: [
          '常務監事因事不能執行職務時，應指定監事 1 人代理之，未指定或不能指定時，由監事互推 1 人代理之。',
          '監事會主席（常務監事）出缺時，應於 1 個月內補選之。',
        ],
      },
      {
        n: '第二十二條',
        paras: ['監事會之職權如下：'],
        items: ['一、監察理事會工作之執行。', '二、審核年度決算。', '三、選舉及罷免常務監事。', '四、議決監事及常務監事之辭職。', '五、其他應監察事項。'],
      },
      { n: '第二十三條', paras: ['理事、監事均為無給職，連選得連任。理事長之連任，以 1 次為限。理事、監事之任期自召開本屆第 1 次理事會之日起計算。'] },
      {
        n: '第二十四條',
        paras: ['理事、監事有下列情事之一者，應即解任：'],
        items: [
          '一、喪失會員（會員代表）資格者。',
          '二、因故辭職經理事會或監事會決議通過者。',
          '三、被罷免或撤免者。',
          '四、受停權處分期間逾任期二分之一者。',
        ],
      },
      {
        n: '第二十五條',
        paras: [
          '本會置秘書長 1 人，承理事長之命處理本會事務，其他工作人員若干人，提經理事會通過後聘免之。',
          '前項工作人員不得由理事、監事擔任。',
          '工作人員權責及分層負責事項由理事會另定之。',
        ],
      },
      { n: '第二十六條', paras: ['本會得設各種委員會、小組或其他內部作業組織，其組織簡則經理事會通過後施行，變更時亦同。'] },
      { n: '第二十七條', paras: ['本會得由理事會聘請名譽理事長 1 人，名譽理事、顧問若干人，其聘期與理事、監事之任期同。'] },
    ],
  },
  {
    title: '第四章　會議',
    articles: [
      {
        n: '第二十八條',
        paras: [
          '會員（會員代表）大會分定期會議與臨時會議 2 種，由理事長召集之，召集時除緊急事故之臨時會議外，應於 15 日前通知全體應出席人員。',
          '定期會議每年召開 1 次，臨時會議於理事會認為必要，或經會員（會員代表）五分之一以上之請求，或監事會函請召集時召開之。',
          '本會辦理法人登記後，臨時會議經會員（會員代表）十分之一以上之請求召開之。',
          '會員（會員代表）大會得以視訊會議或其他經中央主管機關公告之方式召集之，簽到及表決方式則配合電子化設備功能辦理。但涉及選舉、補選、罷免事項，應以實體集會方式辦理。',
        ],
      },
      { n: '第二十九條', paras: ['會員（會員代表）不能親自出席會員大會時，得以書面委託其他會員（會員代表）代理，每 1 會員（會員代表）以代理 1 人為限。'] },
      {
        n: '第三十條',
        paras: ['會員（會員代表）大會之決議，以會員（會員代表）過半數之出席，出席人數過半數或較多數之同意行之。但下列事項之決議以出席人數三分之二以上同意行之。'],
        items: [
          '一、章程之訂定與變更。',
          '二、會員（會員代表）之除名。',
          '三、理事、監事之罷免。',
          '四、財產之處分。',
          '五、本會之解散。',
          '六、其他與會員權利義務有關之重大事項。',
        ],
        after: ['本會辦理法人登記後，章程之變更以出席人數四分之三以上之同意或全體會員三分之二以上書面之同意行之；本會之解散，得隨時以全體會員三分之二以上之可決解散之。'],
      },
      {
        n: '第三十一條',
        paras: [
          '理事會每 6 個月至少舉行會議 1 次，監事會每 6 個月至少舉行會議 1 次，必要時得召開聯席會議或臨時會議。',
          '前項會議召集時除臨時會議外，應於 7 日前通知全體應出席人員，會議之決議，各以理事、監事過半數之出席，出席人數較多數之同意行之。',
        ],
      },
      {
        n: '第三十二條',
        paras: [
          '理事應出席理事會議，監事應出席監事會議，理事會、監事會不得委託出席。',
          '理事會議、監事會議及理監事聯席會議得以視訊會議或其他經中央主管機關公告之方式召集之，簽到及表決方式則配合電子化設備功能辦理。但涉及選舉、補選、罷免事項，應以實體集會方式辦理。',
          '理事、監事連續 2 次無故缺席理事會、監事會者，視同辭職。',
        ],
      },
    ],
  },
  {
    title: '第五章　經費及會計',
    articles: [
      {
        n: '第三十三條',
        paras: ['本會經費來源如下：'],
        items: ['一、入會費。', '二、常年會費。', '三、事業費。', '四、企業、社團及個人之捐款。', '五、委託收益。', '六、基金及其孳息。', '七、其他收入。'],
      },
      {
        n: '第三十四條',
        paras: [
          '本會會計年度以曆年為準，自每年 1 月 1 日起至 12 月 31 日止。',
          '本會於會計年度開始前由理事會編造年度工作計畫及收支預算表，並於年度終了後 3 個月內由理事會編造上年度工作報告及會計報告，送監事會審核後造具審核意見書送還理事會，連同當年度工作計畫及收支預算表，提經會員（會員代表）大會通過後報主管機關備查。會員（會員代表）大會因故未能如期召開，可先經本會理事會及監事會或理監事聯席會議通過，事後提報大會追認後，再報請主管機關備查。',
        ],
      },
      {
        n: '第三十五條',
        paras: [
          '本會於解散後，剩餘財產歸屬所在地之地方自治團體或主管機關指定之機關團體所有。',
          '本會解散之清算人選任及財產清算程序，如本會經法人登記，除法律另有規定外，依民法之規定辦理；如本會未經法人登記，應依會員（會員代表）大會決議辦理，會員（會員代表）大會無法決議時，由理事長擔任清算人，並準用民法清算之規定。',
        ],
      },
    ],
  },
  {
    title: '第六章　附則',
    articles: [
      { n: '第三十六條', paras: ['本章程未規定事項，悉依有關法令規定辦理。'] },
      { n: '第三十七條', paras: ['本章程經會員（會員代表）大會通過後施行，並報主管機關核備，變更時亦同。'] },
      { n: '第三十八條', paras: ['本章程經本會 113 年 1 月 5 日第一屆第一次會員大會通過。'] },
    ],
  },
];

const count = chapters.reduce((n, c) => n + c.articles.length, 0);
---
<BaseLayout
  title="協會章程"
  description={`社團法人台灣好棋寶寶協會章程全文，共 6 章 ${count} 條，113 年 1 月 5 日第一屆第一次會員大會通過，內政部台內團字第 1130005685 號函准予備查。`}
  breadcrumbs={[{ name: '協會', href: '/association/' }, { name: '協會章程', href: '/association/charter/' }]}
>
  <article class="prose">
    <h1>台灣好棋寶寶協會章程</h1>
    <p class="approval">內政部 113 年 2 月台內團字第 1130005685 號函准予備查</p>

    <div class="key-answer" data-question="台灣好棋寶寶協會的章程內容是什麼？">
      <p>章程全文共 6 章 {count} 條，113 年 1 月 5 日經第一屆第一次會員大會通過。內容涵蓋宗旨與任務、三類會員與會費、理監事的名額與任期、會議與決議門檻、經費來源與會計年度。</p>
    </div>

    {chapters.map((ch) => (
      <section class="chapter">
        <h2>{ch.title}</h2>
        {ch.articles.map((a) => (
          <div class="article">
            <p class="no">{a.n}</p>
            <div class="text">
              {a.paras.map((p) => <p>{p}</p>)}
              {a.items && <ul>{a.items.map((i) => <li>{i}</li>)}</ul>}
              {a.after && a.after.map((p) => <p>{p}</p>)}
            </div>
          </div>
        ))}
      </section>
    ))}

    <h2>關於這份文字</h2>
    <p>本頁全文謄錄自協會章程的核備本，條號、用字與分項均照原件，未作潤飾。與原件如有出入，以主管機關核備的版本為準。查詢請來信 <a href={`mailto:${site.email}`}>{site.email}</a>。</p>
    <p>相關頁面：<a href="/association/about/">協會介紹</a>、<a href="/join/">加入協會</a>、<a href="/association/corporate-membership/">企業會員</a>。</p>
  </article>
</BaseLayout>
<style>
  .approval { font-size: var(--text-sm); color: var(--color-ink-muted); margin-top: calc(-1 * var(--space-2)); }
  .chapter { margin-bottom: var(--space-8); }
  .chapter h2 { letter-spacing: 0.1em; }
  .article { display: grid; gap: var(--space-1) var(--space-4); margin-bottom: var(--space-6); }
  @media (min-width: 640px) { .article { grid-template-columns: 6rem 1fr; } }
  .article .no { font-weight: 700; margin: 0; }
  .article .text > :last-child { margin-bottom: 0; }
  .article ul { margin: 0 0 1em; padding-left: 0; list-style: none; }
  .article li { margin-bottom: var(--space-1); }
</style>
