---
import AppLayout from '../../../layouts/AppLayout.astro';
import { consumeState, exchangeCode } from '../../../server/line';
import { findIdentity, createAccountWithIdentity, linkIdentity } from '../../../server/accounts';
import { createSession } from '../../../server/session';
import { audit } from '../../../server/db';
import { safeRedirect, isSecure } from '../../../server/http';
export const prerender = false;

let error = 'LINE 登入沒有完成，請重新試一次。';
const code = Astro.url.searchParams.get('code');
const stateParam = Astro.url.searchParams.get('state');
const state = stateParam ? await consumeState(stateParam) : null;
if (code && state) {
  const profile = await exchangeCode(code, Astro.url.origin);
  if (profile) {
    if (state.purpose === 'link') {
      const me = Astro.locals.account;
      if (!me || me.id !== state.account_id) error = '綁定時的登入狀態已經改變，請重新登入後再綁定。';
      else {
        const r = await linkIdentity(me.id, 'line', profile.sub);
        if (r === 'taken') error = '這個 LINE 帳號已經屬於另一個網站帳號，或你的帳號已經綁定其他 LINE。需要合併請聯絡協會。';
        else return Astro.redirect('/account/?linked=line');
      }
    } else {
      const existing = await findIdentity('line', profile.sub);
      const accountId = existing?.account_id ?? (await createAccountWithIdentity('line', profile.sub, profile.name));
      await createSession(Astro.cookies, accountId, isSecure(Astro.url));
      await audit(accountId, 'login.line', accountId);
      return Astro.redirect(safeRedirect(state.redirect_to));
    }
  }
}
---
<AppLayout title="LINE 登入">
  <div class="prose">
    <h1>LINE 登入</h1>
    <p class="notice notice-error">{error}</p>
    <p><a href="/auth/login/">回到登入頁</a></p>
  </div>
</AppLayout>
