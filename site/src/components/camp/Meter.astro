---
interface Props { ratio: number; label: string }
const { ratio, label } = Astro.props;
---
<div class="meter">
  <span>{label}</span>
  <span class="track" aria-hidden="true"><i style={`width:${Math.round(Math.max(0, Math.min(1, ratio)) * 100)}%`}></i></span>
</div>
<style>
  .meter { display: grid; gap: var(--space-1); font-size: var(--text-xs); color: var(--color-ink-muted); }
  .track { display: block; height: 0.5rem; border-radius: 999px; background: var(--color-bg-soft); overflow: hidden; }
  .track i { display: block; height: 100%; background: var(--color-brand); }
</style>
