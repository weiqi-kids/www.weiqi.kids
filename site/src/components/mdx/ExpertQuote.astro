---
interface Props { author: string; title?: string }
const { author, title } = Astro.props;
---
<blockquote class="expert-quote">
  <div><slot /></div>
  <cite>{author}{title && `，${title}`}</cite>
</blockquote>
<style>
  .expert-quote { margin: 1.5em 0; padding: var(--space-4) var(--space-6); border-left: 4px solid var(--color-brand); background: var(--color-bg-soft); border-radius: var(--radius-sm); }
  .expert-quote cite { display: block; margin-top: var(--space-2); font-style: normal; font-size: var(--text-xs); color: var(--color-ink-muted); }
</style>
