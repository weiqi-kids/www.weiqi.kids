---
import { galleries } from '../data/media.js';
interface Props { name: keyof typeof galleries; heading?: boolean }
const { name, heading = true } = Astro.props;
const g = galleries[name];
---
<section class="gallery">
  {heading && <h2>{g.title}</h2>}
  <ul>
    {g.photos.map((alt, i) => {
      const src = `/media/${name}/${String(i + 1).padStart(2, '0')}.webp`;
      return <li><a href={src}><img src={src} alt={alt} loading="lazy" /></a></li>;
    })}
  </ul>
</section>
<style>
  .gallery { margin-block: var(--space-8); }
  .gallery h2 { font-size: var(--text-lg); }
  .gallery ul { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-2); grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 768px) { .gallery ul { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1024px) { .gallery ul { grid-template-columns: repeat(4, 1fr); } }
  .gallery img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius-sm); display: block; }
</style>
