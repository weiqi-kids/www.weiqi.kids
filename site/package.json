{
  "name": "weiqi-kids-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-design.mjs && node scripts/check-content.mjs && node scripts/build-redirects.mjs && astro build && node scripts/check-links.mjs",
    "preview": "astro preview",
    "deploy": "SHOW_DRAFT_COURSES=1 pnpm build && wrangler deploy",
    "check:design": "node scripts/check-design.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:content:all": "node scripts/check-content.mjs --all",
    "test": "vitest run",
    "build:production": "SITE_ENV=production pnpm build"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.2",
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/react": "^6.0.6",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.3",
    "d3": "^7.9.0",
    "katex": "^0.18.7",
    "mermaid": "^12.0.0",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-katex": "^7.0.1",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0",
    "unist-util-visit": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260922.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.1"
  }
}